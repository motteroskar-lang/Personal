# Copy this to .env.local and fill in your keys

# Claude AI (required for AI features)
ANTHROPIC_API_KEY=sk-ant-...

# Garmin Connect OAuth (optional - get from developer.garmin.com)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_CALLBACK_URL=http://localhost:3000/api/garmin/callback

# Revolut Open Banking (optional - get from developer.revolut.com)
REVOLUT_CLIENT_ID=
REVOLUT_CLIENT_SECRET=
REVOLUT_CALLBACK_URL=http://localhost:3000/api/revolut/callback
REVOLUT_ENVIRONMENT=sandbox

# Scalable Capital (manual CSV import supported)
# No direct API available for retail customers

# App settings
NEXT_PUBLIC_APP_NAME=Personal OS
DATABASE_PATH=./data/personal.db
