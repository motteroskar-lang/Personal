# Copy this to .env.local and fill in your keys

# Turso cloud database (required — get from turso.tech)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Claude AI (required for AI features — get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Garmin Connect OAuth (optional — get from developer.garmin.com)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_CALLBACK_URL=https://your-vercel-app.vercel.app/api/garmin/callback

# Revolut Open Banking (optional — get from developer.revolut.com)
REVOLUT_CLIENT_ID=
REVOLUT_CLIENT_SECRET=
REVOLUT_CALLBACK_URL=https://your-vercel-app.vercel.app/api/revolut/callback
REVOLUT_ENVIRONMENT=sandbox

# Scalable Capital — no direct API for retail customers, use manual CSV import

# App settings
NEXT_PUBLIC_APP_NAME=Personal OS
